<Window x:Class="StaeryCMS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:StaeryCMS.Core.ViewModels;assembly=StaeryCMS.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="StaeryCMS"
        Width="1320"
        Height="820"
        MinWidth="1040"
        MinHeight="620"
        Icon="Assets/staerycms.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <Window.InputBindings>
    <KeyBinding Command="{Binding NewEntryCommand}" Gesture="Ctrl+N" />
    <KeyBinding Command="{Binding SaveCommand}" Gesture="Ctrl+S" />
    <KeyBinding Command="{Binding PreviewCommand}" Gesture="Ctrl+P" />
    <KeyBinding Command="{Binding ExportSiteCommand}" Gesture="Ctrl+Shift+E" />
  </Window.InputBindings>

  <Window.CommandBindings>
    <!-- Ctrl+F -->
    <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindExecuted" />
  </Window.CommandBindings>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248" />
      <ColumnDefinition Width="380" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ============================== Sidebar ============================== -->
    <Border Grid.RowSpan="2" Background="{StaticResource SidebarBrush}">
      <DockPanel Margin="14,20,14,16">

        <!-- Brand -->
        <StackPanel Margin="6,0,0,24" DockPanel.Dock="Top" Orientation="Horizontal">
          <Border Width="38" Height="38" Background="{StaticResource AccentGradientBrush}" CornerRadius="10">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       Text="S" />
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="White" Text="StaeryCMS" />
            <TextBlock FontSize="12" Foreground="{StaticResource SidebarMutedBrush}" Text="Content studio" />
          </StackPanel>
        </StackPanel>

        <Button Margin="0,0,0,24"
                HorizontalAlignment="Stretch"
                Command="{Binding NewEntryCommand}"
                DockPanel.Dock="Top"
                Style="{StaticResource PrimaryButton}"
                ToolTip="Create a new entry (Ctrl+N)">
          <StackPanel Orientation="Horizontal">
            <Path Margin="0,0,8,0" Data="{StaticResource Icon.Add}" Style="{StaticResource Icon}" />
            <TextBlock Text="New entry" />
          </StackPanel>
        </Button>

        <!-- Site settings and export, pinned to the bottom -->
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock Style="{StaticResource SidebarHeader}" Text="SITE" />
          <TextBox Margin="0,0,0,10"
                   Style="{StaticResource SidebarInputBox}"
                   Tag="Site title"
                   Text="{Binding SiteTitle, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Shown in the header of every exported page" />
          <Button Margin="0,0,0,16"
                  Command="{Binding ExportSiteCommand}"
                  Style="{StaticResource SidebarButton}"
                  ToolTip="Generate a static HTML site from all published entries (Ctrl+Shift+E)">
            <StackPanel Orientation="Horizontal">
              <Path Margin="0,0,10,0" Data="{StaticResource Icon.Published}" Style="{StaticResource Icon}" />
              <TextBlock Text="Export static site" />
            </StackPanel>
          </Button>

          <Border Padding="12,10" Background="{StaticResource SidebarHoverBrush}" CornerRadius="8">
            <StackPanel>
              <TextBlock FontSize="12" Foreground="{StaticResource SidebarMutedBrush}">
                <Run FontWeight="SemiBold" Foreground="{StaticResource SidebarTextBrush}" Text="{Binding Statistics.TotalWords, Mode=OneWay, StringFormat={}{0:N0}}" />
                <Run Text="words written" />
              </TextBlock>
              <Button Margin="0,6,0,0"
                      HorizontalAlignment="Left"
                      Command="{Binding OpenDataFolderCommand}"
                      Content="Open data folder"
                      Style="{StaticResource SidebarLinkButton}"
                      ToolTip="{Binding StorageLocation}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Status navigation -->
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Style="{StaticResource SidebarHeader}" Text="LIBRARY" />
          <ListBox ItemContainerStyle="{StaticResource NavItem}"
                   ItemsSource="{Binding StatusFilters}"
                   SelectedItem="{Binding SelectedStatusFilter}"
                   Style="{StaticResource NavList}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:StatusFilterOption}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Path Data="{Binding IconKey, Converter={StaticResource ResourceLookup}}" Style="{StaticResource Icon}" />
                  <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Label}" />
                  <Border Grid.Column="2" MinWidth="24" Padding="7,1" Background="#24FFFFFF" CornerRadius="9">
                    <TextBlock HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Text="{Binding Count}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ============================== Content list ============================== -->
    <Border Grid.Column="1"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header, search and filters -->
        <StackPanel Margin="16,20,16,12">
          <DockPanel Margin="0,0,0,14">
            <Button VerticalAlignment="Bottom"
                    Command="{Binding ClearFiltersCommand}"
                    Content="Clear filters"
                    DockPanel.Dock="Right"
                    Style="{StaticResource LinkButton}"
                    Visibility="{Binding HasActiveFilters, Converter={StaticResource VisibleWhen}}" />
            <StackPanel>
              <TextBlock Style="{StaticResource PageTitle}" Text="{Binding SelectedStatusFilter.Label}" />
              <TextBlock Style="{StaticResource MutedText}" Text="{Binding ResultsText}" />
            </StackPanel>
          </DockPanel>

          <Grid Margin="0,0,0,10">
            <TextBox x:Name="SearchBox"
                     Padding="34,8,10,8"
                     Style="{StaticResource InputBox}"
                     Tag="Search titles, text and tags…  (Ctrl+F)"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
            <Path Margin="11,0,0,0"
                  HorizontalAlignment="Left"
                  Data="{StaticResource Icon.Search}"
                  Fill="{StaticResource MutedTextBrush}"
                  IsHitTestVisible="False"
                  Style="{StaticResource Icon}" />
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding CategoryFilters}"
                      SelectedItem="{Binding SelectedCategoryFilter}"
                      Style="{StaticResource FieldCombo}"
                      ToolTip="Filter by category" />
            <ComboBox Grid.Column="2"
                      DisplayMemberPath="Label"
                      ItemsSource="{Binding SortOptions}"
                      SelectedItem="{Binding SelectedSortOption}"
                      Style="{StaticResource FieldCombo}"
                      ToolTip="Sort order" />
          </Grid>
        </StackPanel>

        <!-- Entries -->
        <ListBox Grid.Row="2"
                 ItemContainerStyle="{StaticResource CardItem}"
                 ItemsSource="{Binding Items}"
                 SelectedItem="{Binding SelectedItem}"
                 Style="{StaticResource CardList}">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ContentListItemViewModel}">
              <StackPanel>
                <DockPanel Margin="0,0,0,4">
                  <ContentControl Margin="8,0,0,0"
                                  VerticalAlignment="Top"
                                  Content="{Binding Status}"
                                  DockPanel.Dock="Right"
                                  Focusable="False" />
                  <TextBlock FontSize="14.5"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource TextBrush}"
                             Text="{Binding Title}"
                             TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock Margin="0,0,0,8"
                           FontSize="12.5"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           MaxHeight="36"
                           Text="{Binding Summary}"
                           TextTrimming="WordEllipsis"
                           TextWrapping="Wrap"
                           Visibility="{Binding Summary, Converter={StaticResource VisibleWhen}}" />
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right"
                             Style="{StaticResource MutedText}"
                             Text="{Binding UpdatedAt, StringFormat={}{0:d MMM yyyy}}" />
                  <TextBlock Style="{StaticResource MutedText}">
                    <Run FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Category, Mode=OneWay}" />
                    <Run Text="{Binding TagsText, Mode=OneWay}" />
                  </TextBlock>
                </DockPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty list -->
        <StackPanel Grid.Row="2"
                    Margin="24,48,24,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Visibility="{Binding IsListEmpty, Converter={StaticResource VisibleWhen}}">
          <Path HorizontalAlignment="Center"
                Data="{StaticResource Icon.Search}"
                Fill="{StaticResource BorderStrongBrush}"
                Style="{StaticResource LargeIcon}" />
          <TextBlock Margin="0,12,0,4"
                     HorizontalAlignment="Center"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     Text="Nothing here yet" />
          <TextBlock HorizontalAlignment="Center"
                     Style="{StaticResource MutedText}"
                     Text="Try another filter or create a new entry." />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================== Editor ============================== -->
    <Grid Grid.Column="2">

      <!-- Nothing selected -->
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Visibility="{Binding HasEditor, Converter={StaticResource CollapsedWhen}}">
        <Border Width="72"
                Height="72"
                HorizontalAlignment="Center"
                Background="{StaticResource AccentSoftBrush}"
                CornerRadius="20">
          <Path HorizontalAlignment="Center"
                Data="{StaticResource Icon.Edit}"
                Fill="{StaticResource AccentBrush}"
                Style="{StaticResource LargeIcon}" />
        </Border>
        <TextBlock Margin="0,18,0,6"
                   HorizontalAlignment="Center"
                   Style="{StaticResource PageTitle}"
                   Text="Select an entry to start editing" />
        <TextBlock Margin="0,0,0,18"
                   HorizontalAlignment="Center"
                   Style="{StaticResource MutedText}"
                   Text="Or create a new one — everything is saved locally as JSON." />
        <Button HorizontalAlignment="Center"
                Command="{Binding NewEntryCommand}"
                Content="New entry"
                Style="{StaticResource PrimaryButton}" />
      </StackPanel>

      <!-- Editor -->
      <Grid Visibility="{Binding HasEditor, Converter={StaticResource VisibleWhen}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Padding="24,14"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,0,1">
          <DockPanel LastChildFill="False">
            <StackPanel VerticalAlignment="Center" DockPanel.Dock="Left" Orientation="Horizontal">
              <ContentControl VerticalAlignment="Center" Content="{Binding Editor.Status}" Focusable="False" />
              <StackPanel Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          Orientation="Horizontal"
                          Visibility="{Binding Editor.IsDirty, Converter={StaticResource VisibleWhen}}">
                <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{StaticResource WarningBrush}" />
                <TextBlock Style="{StaticResource MutedText}" Text="Unsaved changes" />
              </StackPanel>
              <TextBlock Margin="12,0,0,0"
                         VerticalAlignment="Center"
                         Style="{StaticResource MutedText}"
                         Text="New entry — not saved yet"
                         Visibility="{Binding Editor.IsNew, Converter={StaticResource VisibleWhen}}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Margin="0,0,8,0"
                      Command="{Binding PreviewCommand}"
                      Style="{StaticResource SecondaryButton}"
                      ToolTip="Open a preview in your browser (Ctrl+P)">
                <StackPanel Orientation="Horizontal">
                  <Path Margin="0,0,6,0" Data="{StaticResource Icon.Eye}" Style="{StaticResource Icon}" />
                  <TextBlock Text="Preview" />
                </StackPanel>
              </Button>
              <Button Margin="0,0,8,0"
                      Command="{Binding DuplicateCommand}"
                      Style="{StaticResource SecondaryButton}"
                      ToolTip="Duplicate as a new draft">
                <Path Data="{StaticResource Icon.Copy}" Style="{StaticResource Icon}" />
              </Button>
              <Button Margin="0,0,16,0"
                      Command="{Binding DeleteCommand}"
                      Style="{StaticResource DangerButton}"
                      ToolTip="Delete entry">
                <Path Data="{StaticResource Icon.Delete}" Style="{StaticResource Icon}" />
              </Button>
              <Button Margin="0,0,8,0"
                      Command="{Binding RevertCommand}"
                      Content="Discard"
                      Style="{StaticResource SecondaryButton}"
                      ToolTip="Discard unsaved changes" />
              <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" ToolTip="Save (Ctrl+S)">
                <StackPanel Orientation="Horizontal">
                  <Path Margin="0,0,8,0" Data="{StaticResource Icon.Save}" Style="{StaticResource Icon}" />
                  <TextBlock Text="Save" />
                </StackPanel>
              </Button>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Form -->
        <Grid Grid.Row="1" Margin="24,16,24,12" DataContext="{Binding Editor}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <TextBox Margin="-8,0,-8,12"
                   Style="{StaticResource TitleBox}"
                   Tag="Untitled entry"
                   Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

          <!-- Metadata -->
          <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" MinWidth="160" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" MinWidth="130" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="1.3*" MinWidth="140" />
            </Grid.ColumnDefinitions>

            <StackPanel>
              <TextBlock Style="{StaticResource FieldLabel}" Text="SLUG" />
              <TextBox FontFamily="{StaticResource CodeFont}"
                       FontSize="13"
                       Style="{StaticResource InputBox}"
                       Tag="my-first-post"
                       Text="{Binding Slug, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="URL of the exported page. Follows the title until you edit it." />
            </StackPanel>

            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource FieldLabel}" Text="STATUS" />
              <ComboBox ItemsSource="{Binding Statuses}"
                        SelectedItem="{Binding Status}"
                        Style="{StaticResource FieldCombo}" />
            </StackPanel>

            <StackPanel Grid.Column="4">
              <TextBlock Style="{StaticResource FieldLabel}" Text="CATEGORY" />
              <ComboBox IsEditable="True"
                        IsTextSearchEnabled="False"
                        ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource FieldCombo}"
                        Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
              <TextBlock Style="{StaticResource FieldLabel}" Text="SUMMARY" />
              <TextBox Height="62"
                       Style="{StaticResource MultilineBox}"
                       Tag="One or two sentences shown in lists and the site index"
                       Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource FieldLabel}" Text="TAGS" />
              <TextBox Style="{StaticResource InputBox}"
                       Tag="Comma-separated, e.g. dotnet, wpf"
                       Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </Grid>

          <!-- Validation -->
          <Border Grid.Row="3"
                  Margin="0,0,0,14"
                  Padding="12,8"
                  Background="{StaticResource DangerSoftBrush}"
                  BorderBrush="{StaticResource DangerBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Visibility="{Binding HasValidationError, Converter={StaticResource VisibleWhen}}">
            <StackPanel Orientation="Horizontal">
              <Path Margin="0,0,8,0" Data="{StaticResource Icon.Error}" Fill="{StaticResource DangerBrush}" Style="{StaticResource Icon}" />
              <TextBlock VerticalAlignment="Center"
                         FontSize="12.5"
                         Foreground="{StaticResource DangerBrush}"
                         Text="{Binding ValidationError}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <!-- Body -->
          <DockPanel Grid.Row="4">
            <DockPanel Margin="0,0,0,6" DockPanel.Dock="Top">
              <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}" Text="Markdown supported" />
              <TextBlock Margin="0" Style="{StaticResource FieldLabel}" Text="BODY" />
            </DockPanel>
            <TextBox Style="{StaticResource CodeBox}"
                     Tag="Write something great…"
                     Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" />
          </DockPanel>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Padding="24,10"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0">
          <TextBlock Style="{StaticResource MutedText}">
            <Run FontWeight="SemiBold" Text="{Binding Editor.WordCount, Mode=OneWay, StringFormat='{}{0:N0} words'}" />
            <Run Text="·" />
            <Run Text="{Binding Editor.ReadingTimeText, Mode=OneWay}" />
            <Run Text="·  created" />
            <Run Text="{Binding Editor.CreatedAt, Mode=OneWay, StringFormat={}{0:d MMM yyyy}}" />
            <Run Text="·  updated" />
            <Run Text="{Binding Editor.UpdatedAt, Mode=OneWay, StringFormat='{}{0:d MMM yyyy, HH:mm}'}" />
          </TextBlock>
        </Border>
      </Grid>
    </Grid>

    <!-- ============================== Status bar ============================== -->
    <Border Grid.Row="1"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Padding="16,6"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right"
                   Style="{StaticResource MutedText}"
                   Text="Ctrl+N new  ·  Ctrl+S save  ·  Ctrl+P preview  ·  Ctrl+F search" />
        <TextBlock Margin="0,0,16,0" Style="{StaticResource MutedText}" Text="{Binding StatusMessage}" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
